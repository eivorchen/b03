{
  "name": "b03-signal-trace",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "B03 信号寻踪 — 无运行时依赖的双关卡静态游戏",
  "scripts": {
    "dev": "node scripts/serve.js",
    "build": "node scripts/build.js",
    "preview": "node scripts/serve.js dist",
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test",
    "test:release": "npm run build && B03_TEST_BUILD=1 playwright test",
    "check": "npm test && npm run test:release"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  }
}
